{
  "name": "ytm-cuda",
  "image": "ghcr.io/prefix-dev/pixi:0.82.0-noble-cuda-12.9.1",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": { "username": "vscode" }
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "runArgs": ["--gpus", "all"],
  "mounts": ["source=${localWorkspaceFolderBasename}-pixi-cuda,target=${containerWorkspaceFolder}/.pixi,type=volume"],
  "postCreateCommand": "sudo chown vscode .pixi && pixi install -e cuda",
}
